{
	"name": "quorum/dot-notation",
	"description": "Simple PHP Dot Notation Parser",
	"keywords": [
		"dot notation",
		"nested data",
		"path parser"
	],
	"type": "library",
	"require": {
		"php": ">=8.2"
	},
	"require-dev": {
		"corpus/coding-standard": "=0.10.0",
		"corpus/php-cs-fixer-config": "^0.1.1",
		"donatj/mddoc": "=0.13.0",
		"friendsofphp/php-cs-fixer": "=3.95.27",
		"phpstan/phpstan": "=2.3.1",
		"phpunit/phpunit": "^11.5",
		"squizlabs/php_codesniffer": "=4.0.4"
	},
	"license": "MIT",
	"authors": [
		{
			"name": "Jesse G. Donat",
			"email": "donatj@gmail.com",
			"role": "Developer"
		}
	],
	"autoload": {
		"psr-4": {
			"Quorum\\DotNotation\\": "src/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"Quorum\\DotNotation\\": "test/"
		}
	},
	"config": {
		"sort-packages": true,
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		}
	}
}
